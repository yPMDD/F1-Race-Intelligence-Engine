# Copy to .env and fill in. Never commit .env.

# --- Required: the agent will refuse to start without this ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional: override the default model ---
# Default qwen/qwen3.8-27b (450 t/s, 131k ctx, Developer tier 250K TPM).
# NOTE: llama-3.1-8b-instant is gated to Enterprise "Contact Sales" rate
# limits and is not visible to Developer-plan keys.
GROQ_MODEL=qwen/qwen3.8-27b

# --- Database ---
# Local PostgreSQL: use the host's real port (e.g. 5432).
# docker-compose.yml maps 5433 -> 5432, so omit the port when running against
# the container.
DATABASE_URL=postgresql://f1user:f1password@localhost:5433/f1db

# --- Frontend (apps/dashboard) ---
# Leave unset for local dev; set on Vercel to the deployed API origin.
VITE_API_URL=
