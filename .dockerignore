# Keep the image lean -- everything here is either regenerated by
# `uv sync` or is local machine state.

.git
.github
.venv
venv
**/node_modules
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache

# fastf1 HTTP cache + semantic response cache: machine-local, never shipped.
data/cache/

# Local env files. Secrets are injected as environment variables at runtime.
.env
.env.*
!.env.example

# Root-level scratch artefacts
extracted_text.txt
*.mmd
